# ── IBKR Credentials (for Docker / IB Gateway deployment) ────────────────────
# Used by ib-gateway container to log in automatically.
# Never commit the real .env file — it's in .gitignore.
IBKR_USER=your_ibkr_username
IBKR_PASS=your_ibkr_password

# paper = paper trading account (recommended to start)
# live  = live trading account
TRADING_MODE=paper

# ── IBKR API connection ────────────────────────────────────────────────────────
# When running locally with TWS:
#   IBKR_HOST=127.0.0.1  IBKR_PORT=7497 (TWS paper) or 7496 (TWS live)
# When running via Docker (docker-compose):
#   IBKR_HOST=ib-gateway  IBKR_PORT=4002 (Gateway paper) or 4001 (Gateway live)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ── Dashboard ──────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080

# ── VNC (for manual 2FA approval on first IB Gateway login) ───────────────────
# Connect with any VNC client to <server-ip>:5900 using this password.
VNC_PASSWORD=changeme
